(* Author: Diego Bertola *)
(* ====================================================================
   STICK PROTOCOL - 04_BACKWARD_SECRECY
   ==================================================================== *)

(* --- 1. INFRASTRUCTURE AND TYPES --- *)
free c: channel.

type exponent.
type G.
const nil: bitstring.

(* postX travels in the old session, postY in the new one *)
free postX: bitstring [private].
free postY: bitstring [private].

(* Every long-lived secret is global and [private], so that each query names
   exactly the term the processes use. A name bound by new inside main cannot be
   referred to from a query, and a process parameter of the same name would
   shadow the global and leave the correspondence vacuously true *)
free aChainKeyX: bitstring [private].
free aChainKeyY: bitstring [private].
free aSigPrivX: exponent [private].
free aSigPrivY: exponent [private].

(* --- 2. CRYPTOGRAPHIC PRIMITIVES --- *)
fun pk(exponent): G.

fun sign(bitstring, exponent): bitstring.
reduc forall m: bitstring, k: exponent; checksign(sign(m, k), pk(k)) = m.

fun mac(bitstring, bitstring): bitstring.
fun hkdf_ck(bitstring, bitstring): bitstring.
fun hkdf_mk(bitstring, bitstring): bitstring.

fun senc(bitstring, bitstring): bitstring.
reduc forall msg: bitstring, key: bitstring; sdec(senc(msg, key), key) = msg.

(* --- 3. EVENTS AND QUERIES --- *)
event AliceInvia(G, bitstring).
event BobRiceve(G, bitstring).

(* Positive control: the old session must fall once its chain key is
   compromised. If this query passed, the leak would be biting nothing and the
   query on postY would prove very little *)
query attacker(postX).

(* Backward secrecy: the new session holds despite the compromise *)
query attacker(postY).

query m: bitstring; inj-event(BobRiceve(pk(aSigPrivY), m)) ==> inj-event(AliceInvia(pk(aSigPrivY), m)).


(* --- 4. ALICE'S PROCESS --- *)
(* A single process, mirroring the successive principal Alice[...] blocks of the
   Verifpal model: first the old session, then the compromise, then the new one *)
let Alice() =

    (* --- SESSION X, BEFORE THE COMPROMISE --- *)
    let kdfInputX = mac(aChainKeyX, nil) in
    let messageKeyX = hkdf_mk(kdfInputX, nil) in

    let postXEnc = senc(postX, messageKeyX) in
    let postXSigned = sign(postXEnc, aSigPrivX) in

    out(c, (pk(aSigPrivX), postXEnc, postXSigned));

    (* --- PHASE 1: THE ATTACKER STEALS THE OLD CHAIN KEY --- *)
    phase 1;
    out(c, aChainKeyX);

    (* --- SESSION Y, ROTATED AFTER THE COMPROMISE --- *)
    let aSigPubY = pk(aSigPrivY) in

    let kdfInputY = mac(aChainKeyY, nil) in
    let messageKeyY = hkdf_mk(kdfInputY, nil) in

    let postYEnc = senc(postY, messageKeyY) in
    let postYSigned = sign(postYEnc, aSigPrivY) in

    event AliceInvia(aSigPubY, postYEnc);
    out(c, (aSigPubY, postYEnc, postYSigned));
    0.

(* --- 5. BOB'S PROCESS --- *)
(* Receives in session Y, hence after the compromise *)
let Bob(aSigPubY: G) =
    phase 1;
    in(c, (=aSigPubY, postYEnc: bitstring, postYSigned: bitstring));

    let kdfInput = mac(aChainKeyY, nil) in
    let messageKeyYB = hkdf_mk(kdfInput, nil) in

    if checksign(postYSigned, aSigPubY) = postYEnc then
    let postYDec = sdec(postYEnc, messageKeyYB) in

    event BobRiceve(aSigPubY, postYEnc);
    0.


(* --- 6. ENTRY POINT (MAIN) --- *)
process
    let aSigPubY = pk(aSigPrivY) in

    ( Alice() | Bob(aSigPubY) )
