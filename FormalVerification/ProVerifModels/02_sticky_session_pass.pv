(* Author: Diego Bertola / Refactored for Ratchet Proof *)
(* ====================================================================
   STICK PROTOCOL - 02_STICKY_SESSION_PASS
   ==================================================================== *)

(* --- 1. INFRASTRUCTURE AND TYPES --- *)
free c: channel.

free photo1: bitstring [private].
free photo2: bitstring [private].

type exponent.
type G.
type counter.

const nil: bitstring.
fun pk(exponent): G.

(* --- 2. CRYPTOGRAPHIC PRIMITIVES --- *)
fun mac(bitstring, bitstring): bitstring.
fun hkdf_ck(bitstring, bitstring): bitstring.
fun hkdf_mk(bitstring, bitstring): bitstring.

fun senc(bitstring, bitstring): bitstring.
reduc forall msg: bitstring, k: bitstring; sdec(senc(msg, k), k) = msg.

fun sign(bitstring, exponent): bitstring.
reduc forall m: bitstring, k: exponent; checksign(sign(m, k), pk(k)) = m.

fun BlobData(bitstring, bitstring, bitstring): bitstring [data].

(* --- 3. EVENTS & QUERIES --- *)
event AliceInvia(bitstring).
event BobRiceve(bitstring).
event CharlieRiceve(bitstring).

query attacker(photo1).
query attacker(photo2).

query p: bitstring; inj-event(BobRiceve(p)) ==> inj-event(AliceInvia(p)).
query p: bitstring; inj-event(CharlieRiceve(p)) ==> inj-event(AliceInvia(p)).

(* --- 4. ALICE'S PROCESS --- *)
let Alice(aChainKey: bitstring, aSigPriv: exponent) =
    let aSigPub = pk(aSigPriv) in
    
    (* --- MESSAGE 1 --- *)
    new ephAES1: bitstring; new ephMAC1: bitstring;
    let photoEnc1 = senc(photo1, ephAES1) in
    let photoMac1 = mac(photoEnc1, ephMAC1) in
    let blobSec1 = BlobData(ephAES1, ephMAC1, photoMac1) in

    let kdfInput1 = mac(aChainKey, nil) in
    let messageKey1 = hkdf_mk(kdfInput1, nil) in
    let chainKey2 = hkdf_ck(kdfInput1, nil) in (* RATCHET FORWARD *)

    let blobSecEnc1 = senc(blobSec1, messageKey1) in
    let blobSecSigned1 = sign(blobSecEnc1, aSigPriv) in

    event AliceInvia(photo1);
    out(c, (blobSecEnc1, blobSecSigned1, photoEnc1));

    (* --- MESSAGE 2 --- *)
    new ephAES2: bitstring; new ephMAC2: bitstring;
    let photoEnc2 = senc(photo2, ephAES2) in
    let photoMac2 = mac(photoEnc2, ephMAC2) in
    let blobSec2 = BlobData(ephAES2, ephMAC2, photoMac2) in

    let kdfInput2 = mac(chainKey2, nil) in
    let messageKey2 = hkdf_mk(kdfInput2, nil) in
    let chainKey3 = hkdf_ck(kdfInput2, nil) in

    let blobSecEnc2 = senc(blobSec2, messageKey2) in
    let blobSecSigned2 = sign(blobSecEnc2, aSigPriv) in

    event AliceInvia(photo2);
    out(c, (blobSecEnc2, blobSecSigned2, photoEnc2));

    (* --- PHASE 1: COMPROMISE FOR RATCHET FORWARD SECRECY --- *)
    phase 1;
    out(c, chainKey3).

(* --- 5. BOB'S PROCESS --- *)
let Bob(aChainKey: bitstring, aSigPub: G) =
    (* --- RECEIVE MESSAGE 1 --- *)
    in(c, (blobSecEnc1: bitstring, blobSecSigned1: bitstring, photoEnc1: bitstring)) [precise];

    let kdfInput1 = mac(aChainKey, nil) in
    let messageKey1 = hkdf_mk(kdfInput1, nil) in
    let chainKey2 = hkdf_ck(kdfInput1, nil) in (* RATCHET FORWARD, FORGETTING OLD KEY *)

    if checksign(blobSecSigned1, aSigPub) = blobSecEnc1 then
    let BlobData(ephAES1, ephMAC1, photoMac1) = sdec(blobSecEnc1, messageKey1) in
    if mac(photoEnc1, ephMAC1) = photoMac1 then
    let photoDec1 = sdec(photoEnc1, ephAES1) in
    event BobRiceve(photoDec1);

    (* --- RECEIVE MESSAGE 2 --- *)
    in(c, (blobSecEnc2: bitstring, blobSecSigned2: bitstring, photoEnc2: bitstring)) [precise];

    let kdfInput2 = mac(chainKey2, nil) in
    let messageKey2 = hkdf_mk(kdfInput2, nil) in
    let chainKey3 = hkdf_ck(kdfInput2, nil) in

    if checksign(blobSecSigned2, aSigPub) = blobSecEnc2 then
    let BlobData(ephAES2, ephMAC2, photoMac2) = sdec(blobSecEnc2, messageKey2) in
    if mac(photoEnc2, ephMAC2) = photoMac2 then
    let photoDec2 = sdec(photoEnc2, ephAES2) in
    event BobRiceve(photoDec2).

(* --- 6. CHARLIE'S PROCESS --- *)
(* Second recipient of the same broadcast: the Sender Key is shared by every
   group member, so Charlie ratchets in parallel from the same state *)
let Charlie(aChainKey: bitstring, aSigPub: G) =
    (* --- RECEIVE MESSAGE 1 --- *)
    in(c, (blobSecEnc1: bitstring, blobSecSigned1: bitstring, photoEnc1: bitstring)) [precise];

    let kdfInput1 = mac(aChainKey, nil) in
    let messageKey1 = hkdf_mk(kdfInput1, nil) in
    let chainKey2 = hkdf_ck(kdfInput1, nil) in (* RATCHET FORWARD, FORGETTING OLD KEY *)

    if checksign(blobSecSigned1, aSigPub) = blobSecEnc1 then
    let BlobData(ephAES1, ephMAC1, photoMac1) = sdec(blobSecEnc1, messageKey1) in
    if mac(photoEnc1, ephMAC1) = photoMac1 then
    let photoDec1 = sdec(photoEnc1, ephAES1) in
    event CharlieRiceve(photoDec1);

    (* --- RECEIVE MESSAGE 2 --- *)
    in(c, (blobSecEnc2: bitstring, blobSecSigned2: bitstring, photoEnc2: bitstring)) [precise];

    let kdfInput2 = mac(chainKey2, nil) in
    let messageKey2 = hkdf_mk(kdfInput2, nil) in
    let chainKey3 = hkdf_ck(kdfInput2, nil) in

    if checksign(blobSecSigned2, aSigPub) = blobSecEnc2 then
    let BlobData(ephAES2, ephMAC2, photoMac2) = sdec(blobSecEnc2, messageKey2) in
    if mac(photoEnc2, ephMAC2) = photoMac2 then
    let photoDec2 = sdec(photoEnc2, ephAES2) in
    event CharlieRiceve(photoDec2).

(* --- 7. ENTRY POINT (MAIN) --- *)
process
    new aChainKey: bitstring;
    new aSigPriv: exponent;
    let aSigPub = pk(aSigPriv) in

    out(c, aSigPub);
    ( Alice(aChainKey, aSigPriv) | Bob(aChainKey, aSigPub) | Charlie(aChainKey, aSigPub) )
